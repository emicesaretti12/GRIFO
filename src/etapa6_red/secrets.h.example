#pragma once
// ═════════════════════════════════════════════════════════════════════════════
// Copiar a `secrets.h` y completar. **`secrets.h` está en .gitignore.**
//
// Nada de esto va al repositorio. El token de la canilla es la credencial que
// le permite a este ESP32 cobrarle a las tarjetas: con él, cualquiera podría
// abrir y cerrar sesiones en tu nombre.
// ═════════════════════════════════════════════════════════════════════════════

#define WIFI_SSID        "el-wifi-del-bar"
#define WIFI_PASS        "la-clave"

#define SUPABASE_URL     "https://TUPROYECTO.supabase.co"

// La publishable / anon key. Es pública por diseño: lo que protege los datos son
// las policies RLS y el token de la canilla, no el secreto de esta clave.
// **La `sb_secret_` no va acá.** Un dispositivo en la barra nunca la necesita.
#define SUPABASE_ANON    "sb_publishable_..."

// De qué canilla es este ESP32, y su token.
// El token sale de la app: Canillas -> Generar token. Se muestra UNA vez.
#define GRIFO_ID         1
#define GRIFO_TOKEN      "pegar-aca-el-token"

// ── Certificado raíz ────────────────────────────────────────────────────────
// Dejándolo vacío, el firmware se conecta SIN validar el certificado del
// servidor. Anda, pero alguien en la misma red podría hacerse pasar por
// Supabase y robarte el token.
//
// Para producción, pegá acá el certificado raíz de tu proyecto:
//
//   openssl s_client -showcerts -connect TUPROYECTO.supabase.co:443 </dev/null
//
// y copiá el ÚLTIMO bloque -----BEGIN CERTIFICATE----- ... -----END-----
//
// Es la diferencia entre `rejectUnauthorized: false` y validar de verdad.
#define CERT_RAIZ        ""
